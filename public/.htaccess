# =====================================================================
#  Serrurerie de la République — configuration Apache (hébergement OVH)
#  Ce fichier est copié à la racine du site par « npm run build:prod ».
# =====================================================================

Options -Indexes -MultiViews
DirectorySlash Off
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Toujours en HTTPS, toujours avec « www » (une seule adresse pour Google).
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L,NE]

  # 2. Adresses propres : /index.html → /, /page.html → /page, /page/ → /page
  #    (adresse complète en https pour éviter « :443 » ajouté par l'hébergeur)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L,NE]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 3. Sert la page pré-rendue correspondante (/vitrerie-miroiterie → vitrerie-miroiterie.html).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)$ /$1.html [L]
</IfModule>

# ---------------------------------------------------------------------
#  Sécurité
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Politique de contenu : tout est servi par le site lui-même.
  # ➜ Ajouter dans connect-src le service d'envoi des formulaires quand il sera branché.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' data:; media-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

# Fichiers sensibles ou inutiles : jamais servis.
<FilesMatch "(^\.|\.(map|md|log|ts|tsx|json|lock|env)$)">
  Require all denied
</FilesMatch>
<FilesMatch "^(manifest\.webmanifest)$">
  Require all granted
</FilesMatch>

# ---------------------------------------------------------------------
#  Performance : compression et cache
# ---------------------------------------------------------------------
AddType image/webp .webp

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Fichiers versionnés par Vite (nom avec empreinte) : cache d'un an.
  <FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)$|\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
